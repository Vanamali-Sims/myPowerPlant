# Local docker-compose Postgres. Swap this one line for Aurora/Neon later:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-neon-host/app
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# "local" (default) allows localhost/127.0.0.1 on any port, for Vite's port
# hopping. Set to "production" on the deployed Lambda — this makes
# CORS_ORIGINS required and turns off all regex/wildcard matching.
ENVIRONMENT=local

# Comma-separated browser origins. In production this must be the exact
# deployed frontend origin(s), e.g. https://your-app.cloudfront.net — no
# wildcards or ports-any regex are allowed once ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# What if phrasing. Leave LLM_API_KEY blank to keep the fixed sentence.
# LLM_PROVIDER is groq or gemini. Leave LLM_MODEL blank to use openai/gpt-oss-20b (Groq) or gemini-2.5-flash.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
