# Local docker-compose Postgres. Swap this one line for Aurora later:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@aurora-cluster.cluster-xxxx.ap-southeast-2.rds.amazonaws.com:5432/app
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Comma-separated browser origins. Add the Amplify URL when you host the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
